{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "types": ["bun-types"],
    "paths": {
      "lobs/plugin-sdk/memory-core": ["./plugin/types/lobs-plugin-sdk.d.ts"]
    }
  },
  "include": ["server/**/*.ts", "plugin/**/*.ts", "plugin/types/**/*.d.ts"]
}
