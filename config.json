{
  "port": 7420,
  "lmstudio": {
    "baseUrl": "http://localhost:1234/v1",
    "embeddingModel": "text-embedding-nomic-embed-text-v1.5",
    "chatModel": "qwen2.5-1.5b-instruct-mlx"
  },
  "reranker": {
    "mode": "onnx-sidecar"
  },
  "collections": [
    {
      "name": "workspace",
      "path": "~/.openclaw/workspace",
      "pattern": "**/*.md"
    },
    {
      "name": "knowledge",
      "path": "~/lobs-shared-memory",
      "pattern": "**/*.md"
    },
    {
      "name": "sessions",
      "path": "~/.openclaw/agents/main/sessions",
      "pattern": "*.jsonl"
    },
    {
      "name": "projects",
      "path": "~/paw-hub",
      "pattern": "**/*.md",
      "exclude": ["node_modules/**", ".git/**", "dist/**", "build/**"]
    },
    {
      "name": "projects",
      "path": "~/lobs-mobile",
      "pattern": "**/*.md",
      "exclude": ["node_modules/**", ".git/**", "dist/**", "build/**", "Pods/**", ".build/**"]
    },
    {
      "name": "projects",
      "path": "~/lobs/lobs-nexus",
      "pattern": "**/*.md",
      "exclude": ["node_modules/**", ".git/**", "dist/**", "build/**"]
    },
    {
      "name": "projects",
      "path": "~/lobs/lobs-core",
      "pattern": "**/*.md",
      "exclude": ["node_modules/**", ".git/**", "dist/**", "build/**"]
    },
    {
      "name": "projects",
      "path": "~/lobs-memory",
      "pattern": "**/*.md",
      "exclude": ["node_modules/**", ".git/**", "dist/**", "build/**"]
    },
    {
      "name": "projects",
      "path": "~/paw-designs",
      "pattern": "**/*.md",
      "exclude": ["node_modules/**", ".git/**", "dist/**", "build/**"]
    },
    {
      "name": "projects",
      "path": "~/bot-shared",
      "pattern": "**/*.md",
      "exclude": ["node_modules/**", ".git/**", "dist/**", "build/**"]
    }
  ],
  "search": {
    "vectorWeight": 0.7,
    "textWeight": 0.3,
    "candidateMultiplier": 4,
    "maxResults": 8,
    "mmr": {
      "enabled": true,
      "lambda": 0.7
    },
    "temporalDecay": {
      "enabled": true,
      "halfLifeDays": 30
    },
    "reranking": {
      "enabled": true,
      "candidateCount": 15
    },
    "queryExpansion": {
      "enabled": true,
      "strongSignalThreshold": 0.8
    }
  },
  "chunking": {
    "targetTokens": 300,
    "overlapTokens": 40
  },
  "indexing": {
    "debounceMs": 2000,
    "watchEnabled": true,
    "syncIntervalMs": 60000
  }
}
