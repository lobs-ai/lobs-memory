{
    "port": 7420,
    "lmstudio": {
        "baseUrl": "http://localhost:1234/v1",
        "embeddingModel": "text-embedding-qwen3-embedding-4b",
        "chatModel": "qwen2.5-1.5b-instruct-mlx"
    },
    "reranker": {
        "mode": "none"
    },
    "collections": [
        {
            "name": "agent-memory",
            "path": "~/.lobs/agents/main/context/memory",
            "pattern": "**/*.md"
        },
        {
            "name": "agent-context",
            "path": "~/.lobs/agents/main/context",
            "pattern": "*.md",
            "exclude": [
                "memory/**"
            ]
        },
        {
            "name": "knowledge",
            "path": "~/lobs/lobs-shared-memory",
            "pattern": "**/*.md"
        },
        {
            "name": "sessions",
            "path": "~/.lobs/agents/main/sessions",
            "pattern": "*.jsonl"
        },
        {
            "name": "lobs-core",
            "path": "~/lobs/lobs-core",
            "pattern": [
                "**/*.md",
                "**/*.ts"
            ],
            "exclude": [
                "**/node_modules/**",
                "**/.git/**",
                "**/dist/**",
                "**/build/**",
                "nexus/**",
                "memory/**",
                "**/venv/**",
                "**/tools-venv/**",
                "**/site-packages/**"
            ]
        },
        {
            "name": "lobs-core-memory",
            "path": "~/lobs/lobs-core/memory",
            "pattern": "**/*.md",
            "exclude": [
                "**/node_modules/**",
                "**/.git/**",
                "**/dist/**",
                "**/build/**"
            ]
        },
        {
            "name": "lobs-nexus",
            "path": "~/lobs/lobs-nexus",
            "pattern": "**/*.md",
            "exclude": [
                "**/node_modules/**",
                "**/.git/**",
                "**/dist/**",
                "**/build/**",
                "**/venv/**",
                "**/site-packages/**"
            ]
        },
        {
            "name": "lobs-sentinel",
            "path": "~/lobs/lobs-sentinel",
            "pattern": [
                "**/*.md",
                "**/*.ts"
            ],
            "exclude": [
                "**/node_modules/**",
                "**/.git/**",
                "**/dist/**",
                "**/build/**"
            ]
        },
        {
