        },
        {
            "name": "paw-portal",
            "path": "~/paw/paw-portal",
            "pattern": [
                "**/*.md",
                "src/**/*.{ts,tsx,js,jsx}"
            ],
            "exclude": [
                "**/node_modules/**",
                "**/.git/**",
                "**/dist/**",
                "**/build/**"
            ]
        },
        {
            "name": "paw-plugin",
            "path": "~/paw/paw-plugin",
            "pattern": [
                "**/*.md",
                "**/*.ts"
            ],
            "exclude": [
                "**/node_modules/**",
                "**/.git/**",
                "**/dist/**",
                "**/build/**"
            ]
        },
        {
            "name": "trident",
