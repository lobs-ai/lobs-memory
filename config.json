                "**/dist/**",
                "**/build/**"
            ]
        },
        {
            "name": "version-claw",
            "path": "~/paw/version-claw",
            "pattern": [
                "**/*.md",
                "**/*.ts"
            ],
            "exclude": [
                "**/node_modules/**",
                "**/.git/**",
                "**/dist/**",
                "**/build/**"
            ]
        },
        {
            "name": "ship-api",
            "path": "~/paw/ship-api",
            "pattern": "**/*.md",
            "exclude": [
                "**/node_modules/**",
                "**/.git/**",
                "**/dist/**",
                "**/build/**",
                "**/venv/**",
                "**/site-packages/**"
            ]
        },
        {
            "name": "ship-services",
            "path": "~/paw/ship-services",
            "pattern": [
                "**/*.md",
                "**/*.ts"
            ],
            "exclude": [
                "**/node_modules/**",
                "**/.git/**",
                "**/dist/**",
                "**/build/**"
            ]
        },
        {
            "name": "lobs-sail",
            "path": "~/paw/lobs-sail",
            "pattern": [
                "**/*.md",
                "**/*.ts"
            ],
            "exclude": [
                "**/node_modules/**",
                "**/.git/**",
                "**/dist/**",
                "**/build/**"
            ]
        },
        {
            "name": "lobs-sets-sail",
            "path": "~/paw/lobs-sets-sail",
            "pattern": "**/*.md",
            "exclude": [
                "**/node_modules/**",
                "**/.git/**",
                "**/dist/**",
                "**/build/**",
                "**/venv/**",
                "**/site-packages/**"
            ]
        },
        {
            "name": "paw-designs",
            "path": "~/paw/paw-designs",
            "pattern": "**/*.md",
            "exclude": [
                "**/node_modules/**",
                "**/.git/**",
                "**/dist/**",
                "**/build/**"
            ]
        },
        {
            "name": "paw-docs",
            "path": "~/paw/docs",
            "pattern": "**/*.md",
            "exclude": [
                "**/.git/**"
            ]
        },
        {
            "name": "paw-proposals",
            "path": "~/paw/proposals",
            "pattern": "**/*.md",
            "exclude": [
                "**/.git/**"
            ]
        },
        {
            "name": "bot-shared",
            "path": "~/paw/bot-shared",
            "pattern": "**/*.md",
            "exclude": [
                "**/node_modules/**",
                "**/.git/**",
                "**/dist/**",
                "**/build/**"
            ]
        },
        {
            "name": "service-sdk",
            "path": "~/paw/service-sdk",
            "pattern": "**/*.md",
            "exclude": [
                "**/node_modules/**",
                "**/.git/**",
                "**/dist/**"
            ]
        },
        {
            "name": "service-sdk-python",
            "path": "~/paw/service-sdk-python",
            "pattern": [
                "**/*.md",
                "**/*.py"
            ],
            "exclude": [
                "**/.git/**",
                "**/venv/**",
                "**/site-packages/**",
                "**/__pycache__/**"
            ]
        }
    ],
    "search": {
        "vectorWeight": 0.7,
        "textWeight": 0.3,
        "candidateMultiplier": 4,
        "maxResults": 8,
        "mmr": {
            "enabled": true,
            "lambda": 0.7
        },
        "temporalDecay": {
            "enabled": true,
            "halfLifeDays": 30
        },
        "reranking": {
            "enabled": true,
            "candidateCount": 20
        },
        "queryExpansion": {
            "enabled": false,
            "strongSignalThreshold": 0.8
        }
    },
    "chunking": {
        "targetTokens": 300,
        "overlapTokens": 40
    },
    "indexing": {
        "debounceMs": 2000,
        "watchEnabled": true,
        "syncIntervalMs": 300000
    }
}
